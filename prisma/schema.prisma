generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  full_name               String?
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt
  ai_systems              AiSystem[]
  audit_logs              AuditLog[]
  evidence                ComplianceEvidence[]
  compliance_reports      ComplianceReport[]
  conformity_assessments  ConformityAssessment[]
  feedback                Feedback[]
  final_risk_assessments  FinalRiskAssessment[]
  github_action_installs  GitHubActionInstall[]
  github_connections      GithubConnection[]
  llm_capability_analyses LlmCapabilityAnalysis[]
  monitoring_alerts       MonitoringAlert[]
  pr_scans                PRScan[]
  repo_scans              RepoScan[]
  risk_assessments        RiskAssessment[]
  subscription            Subscription?
  github_repos            UserGithubRepo[]

  @@index([email])
  @@map("users")
}

model GithubConnection {
  id                      String    @id @default(cuid())
  user_id                 String
  github_username         String
  github_oauth_token      String
  github_token_expires_at DateTime?
  connected_at            DateTime  @default(now())
  last_refreshed_at       DateTime?
  user                    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, github_username])
  @@index([user_id])
  @@map("github_connections")
}

model RepoScan {
  id                       String                 @id @default(cuid())
  user_id                  String
  github_repo_url          String
  repo_owner               String
  repo_name                String
  repo_description         String?
  readme_content           String?
  package_json_content     Json?
  requirements_txt_content String?
  pyproject_toml_content   Json?
  file_tree                Json
  total_files              Int
  primary_language         String?
  license_type             String?
  stars_count              Int                    @default(0)
  forks_count              Int                    @default(0)
  watchers_count           Int                    @default(0)
  scanned_at               DateTime               @default(now())
  expires_at               DateTime               @default(dbgenerated("(now() + '30 days'::interval)"))
  scan_token               String?                @unique
  scan_history             AiSystemScan[]         @relation("ScanHistory")
  ai_system                AiSystem?              @relation("AiSystemLatestScan")
  final_risk_assessment    FinalRiskAssessment?
  llm_analysis             LlmCapabilityAnalysis?
  user                     User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  risk_assessment          RiskAssessment?

  @@index([user_id])
  @@index([github_repo_url])
  @@index([scanned_at])
  @@map("repo_scans")
}

model UserGithubRepo {
  id              String   @id @default(cuid())
  user_id         String
  github_repo_url String
  repo_name       String
  repo_visibility String
  last_synced_at  DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, github_repo_url])
  @@index([user_id])
  @@map("user_github_repos")
}

model LlmCapabilityAnalysis {
  id                        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  repo_scan_id              String          @unique
  user_id                   String
  is_ai_system              Boolean
  capabilities              Json            @default("[]")
  libraries                 Json            @default("[]")
  ai_frameworks             Json            @default("[]")
  programming_languages     Json            @default("[]")
  detected_model_types      Json            @default("[]")
  has_ml_pipeline           Boolean         @default(false)
  has_training_code         Boolean         @default(false)
  has_inference_code        Boolean         @default(false)
  has_data_processing       Boolean         @default(false)
  has_model_serialization   Boolean         @default(false)
  estimated_risk_indicators Json            @default("{}")
  llm_model_used            String
  analysis_duration_ms      Int
  confidence_score          Float
  analysis_notes            String?
  manual_review_needed      Boolean         @default(false)
  analyzed_at               DateTime        @default(now()) @db.Timestamptz(6)
  expires_at                DateTime        @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  repo_scan                 RepoScan        @relation(fields: [repo_scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                      User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  risk_assessment           RiskAssessment?

  @@index([analyzed_at], map: "idx_llm_capability_analyses_analyzed_at")
  @@index([repo_scan_id], map: "idx_llm_capability_analyses_repo_scan_id")
  @@index([user_id], map: "idx_llm_capability_analyses_user_id")
  @@map("llm_capability_analyses")
}

model RiskAssessment {
  id                         String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  repo_scan_id               String                @unique
  llm_analysis_id            String                @unique
  user_id                    String
  risk_classification        String
  risk_score                 Int
  risk_narrative             String?
  matched_annex_iii_articles Json                  @default("[]")
  unmatched_risk_indicators  Json                  @default("[]")
  is_unacceptable            Boolean               @default(false)
  is_high_risk               Boolean               @default(false)
  is_limited_risk            Boolean               @default(false)
  is_minimal_risk            Boolean               @default(false)
  key_findings               Json                  @default("[]")
  assessed_at                DateTime              @default(now()) @db.Timestamptz(6)
  assessment_version         Int                   @default(1)
  manual_review_needed       Boolean               @default(false)
  manual_review_reason       String?
  tailored_questions         Json?
  final_risk_assessment      FinalRiskAssessment?
  llm_analysis               LlmCapabilityAnalysis @relation(fields: [llm_analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  repo_scan                  RepoScan              @relation(fields: [repo_scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                       User                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assessed_at], map: "idx_risk_assessments_assessed_at")
  @@index([risk_classification], map: "idx_risk_assessments_classification")
  @@index([repo_scan_id], map: "idx_risk_assessments_repo_scan_id")
  @@index([user_id], map: "idx_risk_assessments_user_id")
  @@map("risk_assessments")
}

model FinalRiskAssessment {
  id                         String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  risk_assessment_id         String            @unique
  repo_scan_id               String            @unique
  user_id                    String
  final_risk_classification  String
  final_risk_score           Int
  final_narrative            String?
  context_verified           Boolean           @default(false)
  context_summary            Json              @default("{}")
  context_answers            Json              @default("{}")
  evidence_items             Json              @default("[]")
  final_matched_articles     Json              @default("[]")
  unresolved_risk_indicators Json              @default("[]")
  escalation_reason          String?
  compliance_readiness       Json              @default("{}")
  approved_for_report        Boolean           @default(false)
  requires_manual_review     Boolean           @default(false)
  manual_review_notes        String?
  reviewer_id                String?
  verified_at                DateTime          @default(now()) @db.Timestamptz(6)
  verification_version       Int               @default(1)
  compliance_report          ComplianceReport?
  repo_scan                  RepoScan          @relation(fields: [repo_scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  risk_assessment            RiskAssessment    @relation(fields: [risk_assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                       User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([approved_for_report], map: "idx_final_risk_assessments_approved")
  @@index([final_risk_classification], map: "idx_final_risk_assessments_classification")
  @@index([repo_scan_id], map: "idx_final_risk_assessments_repo_scan_id")
  @@index([risk_assessment_id], map: "idx_final_risk_assessments_risk_assessment_id")
  @@index([user_id], map: "idx_final_risk_assessments_user_id")
  @@index([verified_at], map: "idx_final_risk_assessments_verified_at")
  @@map("final_risk_assessments")
}

model ComplianceReport {
  id                       String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  final_risk_assessment_id String              @unique
  user_id                  String
  file_name                String
  file_path                String
  file_url                 String?
  file_size                Int
  risk_classification      String
  risk_score               Int
  digital_signature        String?
  signed_at                DateTime?           @db.Timestamptz(6)
  version                  Int                 @default(1)
  generated_at             DateTime            @default(now()) @db.Timestamptz(6)
  expires_at               DateTime?           @db.Timestamptz(6)
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  updated_at               DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  final_risk_assessment    FinalRiskAssessment @relation(fields: [final_risk_assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                     User                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, file_name], map: "idx_compliance_reports_user_file")
  @@index([generated_at], map: "idx_compliance_reports_generated_at")
  @@index([user_id], map: "idx_compliance_reports_user_id")
  @@map("compliance_reports")
}

model GitHubActionInstall {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id               String
  repo_full_name        String
  repo_id               Int?
  status                String?   @default("active")
  block_on_high_risk    Boolean?  @default(false)
  block_on_unacceptable Boolean?  @default(true)
  notify_slack          Boolean?  @default(false)
  slack_webhook_url     String?
  installed_at          DateTime? @default(now()) @db.Timestamptz(6)
  last_scan_at          DateTime? @db.Timestamptz(6)
  total_scans           Int?      @default(0)
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, repo_full_name])
  @@index([repo_full_name], map: "idx_github_action_installs_repo_full_name")
  @@index([status], map: "idx_github_action_installs_status")
  @@index([user_id], map: "idx_github_action_installs_user_id")
  @@map("github_action_installs")
}

model PRScan {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id             String
  repo_full_name      String
  pr_number           Int
  pr_title            String
  pr_url              String
  head_sha            String
  risk_level          String
  matched_patterns    String[]  @default([])
  matched_constraints String[]  @default([])
  blocked             Boolean?  @default(false)
  comment_posted      Boolean?  @default(false)
  scanned_at          DateTime? @default(now()) @db.Timestamptz(6)
  scan_duration_ms    Int?
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pr_number], map: "idx_pr_scans_pr_number")
  @@index([repo_full_name], map: "idx_pr_scans_repo_full_name")
  @@index([risk_level], map: "idx_pr_scans_risk_level")
  @@index([scanned_at], map: "idx_pr_scans_scanned_at")
  @@index([user_id], map: "idx_pr_scans_user_id")
  @@map("pr_scans")
}

model Subscription {
  id                      String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id                 String    @unique
  tier                    String?   @default("free")
  status                  String?   @default("active")
  repos_limit             Int?      @default(1)
  scans_limit             Int?      @default(5)
  pr_scans_limit          Int?      @default(0)
  reports_limit           Int?      @default(1)
  repos_used              Int?      @default(0)
  scans_used              Int?      @default(0)
  pr_scans_used           Int?      @default(0)
  reports_used            Int?      @default(0)
  usage_reset_at          DateTime? @default(now()) @db.Timestamptz(6)
  payment_customer_id     String?   @unique @map("stripe_customer_id")
  payment_subscription_id String?   @unique @map("stripe_subscription_id")
  payment_product_id      String?   @map("stripe_price_id")
  current_period_start    DateTime? @db.Timestamptz(6)
  current_period_end      DateTime? @db.Timestamptz(6)
  cancel_at_period_end    Boolean?  @default(false)
  is_manual_grant         Boolean?  @default(false)
  manual_grant_reason     String?
  granted_by              String?
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  payment_provider        String    @default("dodo")
  user                    User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_subscriptions_status")
  @@index([payment_customer_id], map: "idx_subscriptions_stripe_customer_id")
  @@index([tier], map: "idx_subscriptions_tier")
  @@map("subscriptions")
}

model Feedback {
  id         String   @id @default(cuid())
  user_id    String?
  rating     Int
  comment    String?
  page_url   String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([created_at])
  @@map("feedback")
}

model AiSystem {
  id                     String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id                String
  name                   String
  description            String?
  source_repo_url        String?
  latest_scan_id         String?               @unique
  risk_classification    String?
  risk_score             Int?
  status                 String                @default("active")
  lifecycle_stage        String                @default("development")
  last_scanned_at        DateTime?             @db.Timestamptz(6)
  capabilities           Json?
  matched_articles       Json?
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  public_share_id        String?               @unique
  share_enabled          Boolean?              @default(false)
  last_commit_sha        String?
  files_changed_count    Int?                  @default(0)
  drift_detected         Boolean?              @default(false)
  drift_checked_at       DateTime?             @db.Timestamptz(6)
  scan_history           AiSystemScan[]
  latest_scan            RepoScan?             @relation("AiSystemLatestScan", fields: [latest_scan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                   User                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audit_logs             AuditLog[]
  documents              ComplianceDocument[]
  evidence               ComplianceEvidence[]
  conformity_assessments ConformityAssessment?
  alerts                 MonitoringAlert[]

  @@unique([user_id, name])
  @@index([public_share_id], map: "idx_ai_systems_public_share_id")
  @@index([risk_classification], map: "idx_ai_systems_risk_classification")
  @@index([status], map: "idx_ai_systems_status")
  @@index([user_id], map: "idx_ai_systems_user_id")
  @@map("ai_systems")
}

model AiSystemScan {
  id                      String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  ai_system_id            String
  repo_scan_id            String
  risk_classification     String?
  risk_score              Int?
  previous_classification String?
  classification_changed  Boolean?  @default(false)
  scanned_at              DateTime? @default(now()) @db.Timestamptz(6)
  ai_system               AiSystem  @relation(fields: [ai_system_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  repo_scan               RepoScan  @relation("ScanHistory", fields: [repo_scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([ai_system_id, repo_scan_id])
  @@index([ai_system_id], map: "idx_ai_system_scans_ai_system_id")
  @@index([scanned_at], map: "idx_ai_system_scans_scanned_at")
  @@map("ai_system_scans")
}

model ComplianceDocument {
  id                 String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  ai_system_id       String
  document_type      String
  title              String
  content            Json
  template_version   String?   @default("1.0")
  status             String?   @default("draft")
  completion_percent Int?      @default(0)
  missing_fields     Json?
  version            Int?      @default(1)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  ai_system          AiSystem  @relation(fields: [ai_system_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([ai_system_id, document_type])
  @@map("compliance_documents")
}

model MonitoringAlert {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id      String
  ai_system_id String?
  category     String
  severity     String?   @default("info")
  title        String
  message      String
  status       String?   @default("unread")
  resolved_at  DateTime? @db.Timestamptz(6)
  resolved_by  String?
  metadata     Json?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  ai_system    AiSystem? @relation(fields: [ai_system_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("monitoring_alerts")
}

model AuditLog {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id       String
  ai_system_id  String?
  action        String
  entity_type   String
  entity_id     String?
  description   String
  metadata      Json?
  previous_hash String?
  hash          String
  ip_address    String?
  user_agent    String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  ai_system     AiSystem? @relation(fields: [ai_system_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ai_system_id], map: "idx_audit_logs_ai_system_id")
  @@index([user_id], map: "idx_audit_logs_user_id")
  @@map("audit_logs")
}

model ComplianceEvidence {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id       String
  ai_system_id  String
  evidence_type String
  title         String
  description   String?
  file_url      String?
  file_name     String?
  file_size     Int?
  mime_type     String?
  source_type   String?
  source_id     String?
  collected_at  DateTime? @default(now()) @db.Timestamptz(6)
  collected_by  String
  hash          String
  verified      Boolean?  @default(false)
  verified_at   DateTime? @db.Timestamptz(6)
  verified_by   String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  ai_system     AiSystem  @relation(fields: [ai_system_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_compliance_evidence_user_id")
  @@map("compliance_evidence")
}

model RegulatoryUpdate {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  source            String
  source_url        String?
  reference_id      String?   @unique
  title             String
  summary           String
  content           String?
  update_type       String
  severity          String?   @default("info")
  affected_articles String[]
  affected_risks    String[]
  published_at      DateTime  @db.Timestamptz(6)
  effective_date    DateTime? @db.Timestamptz(6)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([published_at], map: "idx_regulatory_updates_published")
  @@index([severity], map: "idx_regulatory_updates_severity")
  @@index([update_type], map: "idx_regulatory_updates_type")
  @@map("regulatory_updates")
}

model ConformityAssessment {
  id                       String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  ai_system_id             String    @unique
  user_id                  String
  assessment_module        String
  module_name              String
  legal_basis              String
  current_step             Int       @default(0)
  total_steps              Int
  steps_data               Json
  status                   String    @default("not_started")
  completion_percent       Int       @default(0)
  requires_notified_body   Boolean   @default(false)
  self_assessment_eligible Boolean   @default(false)
  estimated_timeline       String?
  risk_classification      String?
  annex_iii_category       Int?
  notes                    Json?
  target_date              DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  ai_system                AiSystem  @relation(fields: [ai_system_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conformity_ai_system")
  user                     User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conformity_user")

  @@index([user_id])
  @@index([status])
  @@map("conformity_assessments")
}

model DemoRequest {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  full_name    String
  work_email   String
  company_name String
  company_size String
  role         String?
  use_case     String?
  status       String   @default("new")
  notes        String?
  ip_address   String?
  user_agent   String?
  referrer     String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([work_email])
  @@index([status])
  @@index([created_at])
  @@map("demo_requests")
}
