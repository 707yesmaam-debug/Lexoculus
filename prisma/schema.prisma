// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  full_name  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Feature 1 relationships
  github_connections GithubConnection[]
  repo_scans         RepoScan[]
  github_repos       UserGithubRepo[]

  // Feature 2 relationships
  llm_capability_analyses LlmCapabilityAnalysis[]

  // Feature 3 relationships
  risk_assessments RiskAssessment[]

  // Feature 4 relationships
  final_risk_assessments FinalRiskAssessment[]

  // Feature 5 relationships
  compliance_reports ComplianceReport[]

  // GitHub Action MVP relationships
  github_action_installs GitHubActionInstall[]
  pr_scans               PRScan[]

  // Subscription & Billing
  subscription Subscription?
  
  // Feedback
  feedback     Feedback[]

  // AI System Registry
  ai_systems   AiSystem[]
  
  // Monitoring Alerts (Phase 3.3)
  monitoring_alerts MonitoringAlert[]
  
  // Audit & Evidence (Phase 4)
  audit_logs        AuditLog[]
  evidence          ComplianceEvidence[]
  
  // Conformity Assessment (Phase 5)
  conformity_assessments ConformityAssessment[]

  @@index([email])
  @@map("users")
}

model GithubConnection {
  id                      String    @id @default(cuid())
  user_id                 String
  github_username         String
  github_oauth_token      String    // Encrypted with AES-256-GCM
  github_token_expires_at DateTime?
  connected_at            DateTime  @default(now())
  last_refreshed_at       DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, github_username])
  @@index([user_id])
  @@map("github_connections")
}

model RepoScan {
  id               String  @id @default(cuid())
  user_id          String
  github_repo_url  String
  repo_owner       String
  repo_name        String
  repo_description String?

  // Raw data from GitHub - INPUT for Feature 2
  readme_content           String?
  package_json_content     Json?
  requirements_txt_content String?
  pyproject_toml_content   Json?
  file_tree                Json    // Directory structure

  // Metadata
  total_files      Int
  primary_language String?
  license_type     String?
  stars_count      Int     @default(0)
  forks_count      Int     @default(0)
  watchers_count   Int     @default(0)

  // Anonymous scan support
  scan_token String?  @unique  // UUID token for anonymous scan ownership

  scanned_at DateTime @default(now())
  expires_at DateTime @default(dbgenerated("(now() + interval '30 days')"))

  user                  User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  llm_analysis          LlmCapabilityAnalysis? // One-to-one: each scan has one analysis
  risk_assessment       RiskAssessment?        // One-to-one: each scan has one risk assessment
  final_risk_assessment FinalRiskAssessment?   // One-to-one: each scan has one final assessment
  ai_system             AiSystem?              @relation("AiSystemLatestScan") // Link to AI System Registry
  scan_history          AiSystemScan[]         @relation("ScanHistory") // Phase 1.2: History tracking

  @@index([user_id])
  @@index([github_repo_url])
  @@index([scanned_at])
  @@map("repo_scans")
}

model UserGithubRepo {
  id              String   @id @default(cuid())
  user_id         String
  github_repo_url String
  repo_name       String
  repo_visibility String   // "public" or "private"
  last_synced_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, github_repo_url])
  @@index([user_id])
  @@map("user_github_repos")
}

// Feature 2: LLM Capability Analysis
model LlmCapabilityAnalysis {
  id           String @id @default(cuid())
  repo_scan_id String @unique
  user_id      String

  // Core analysis results
  is_ai_system          Boolean
  capabilities          Json // ["Computer Vision", "NLP", "Recommender"]
  libraries             Json // ["torch", "tensorflow", "scikit-learn"]
  ai_frameworks         Json // ["PyTorch", "TensorFlow", "Hugging Face"]
  programming_languages Json // ["Python", "JavaScript"]
  detected_model_types  Json // ["Neural Network", "Transformer", "Decision Tree"]

  // Code structure indicators
  has_ml_pipeline         Boolean @default(false)
  has_training_code       Boolean @default(false)
  has_inference_code      Boolean @default(false)
  has_data_processing     Boolean @default(false)
  has_model_serialization Boolean @default(false)

  // Risk indicators (pre-classified for Feature 3)
  estimated_risk_indicators Json

  // LLM metadata
  llm_model_used       String
  analysis_duration_ms Int
  confidence_score     Float // 0-1
  analysis_notes       String?
  manual_review_needed Boolean @default(false)

  // Timestamps
  analyzed_at DateTime @default(now())
  expires_at  DateTime @default(dbgenerated("(now() + interval '30 days')"))

  // Relationships
  repo_scan       RepoScan        @relation(fields: [repo_scan_id], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  risk_assessment RiskAssessment? // Link to Feature 3

  @@index([repo_scan_id])
  @@index([user_id])
  @@index([analyzed_at])
  @@map("llm_capability_analyses")
}

// Feature 3: Risk Assessment (Annex III Mapping)
model RiskAssessment {
  id              String @id @default(cuid())
  repo_scan_id    String @unique
  llm_analysis_id String @unique
  user_id         String

  // Risk Classification
  risk_classification String // UNACCEPTABLE, HIGH_RISK, LIMITED_RISK, MINIMAL_RISK
  risk_score          Int    // 0-100
  risk_narrative      String?

  // Annex III Matching
  matched_annex_iii_articles Json // Array of matched articles
  unmatched_risk_indicators  Json // Array of unmatched indicators

  // Preliminary Assessment Flags
  is_unacceptable Boolean @default(false)
  is_high_risk    Boolean @default(false)
  is_limited_risk Boolean @default(false)
  is_minimal_risk Boolean @default(false)

  // Key Findings
  key_findings Json // Array of strings

  // Dynamic Questions (Feature 7)
  tailored_questions Json? // Array of { id, question, type } generated by AI

  // Metadata
  assessed_at          DateTime @default(now())
  assessment_version   Int      @default(1)
  manual_review_needed Boolean  @default(false)
  manual_review_reason String?

  // Relationships
  repo_scan             RepoScan              @relation(fields: [repo_scan_id], references: [id], onDelete: Cascade)
  llm_analysis          LlmCapabilityAnalysis @relation(fields: [llm_analysis_id], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  final_risk_assessment FinalRiskAssessment?  // Link to Feature 4

  @@index([repo_scan_id])
  @@index([user_id])
  @@index([risk_classification])
  @@index([assessed_at])
  @@map("risk_assessments")
}

// Feature 4: Final Risk Assessment (Context Verified)
model FinalRiskAssessment {
  id                 String @id @default(cuid())
  risk_assessment_id String @unique
  repo_scan_id       String @unique
  user_id            String

  // Final Classification (after context verification)
  final_risk_classification String // UNACCEPTABLE, HIGH_RISK, LIMITED_RISK, MINIMAL_RISK
  final_risk_score          Int    // 0-100
  final_narrative           String?

  // Context Verification
  context_verified Boolean @default(false)
  context_summary  Json    // { intended_use, target_users, deployment_region, has_human_oversight, etc. }
  context_answers  Json    // Full user responses to verification questions

  // Evidence Items (supports final classification)
  evidence_items Json // Array of { category, description, supports_classification, regulatory_reference, confidence }

  // Final Matched Articles (with verified applicability)
  final_matched_articles Json // Array of { article, category, verified, requirements, user_confirmed_measures }

  // Unresolved Issues
  unresolved_risk_indicators Json    // Risk indicators user couldn't address
  escalation_reason          String? // Why escalated to manual review

  // Compliance Readiness
  compliance_readiness Json // { overall_readiness, requirements_met, requirements_pending, developer_action_items }

  // Approval Status
  approved_for_report   Boolean @default(false)
  requires_manual_review Boolean @default(false)
  manual_review_notes   String?
  reviewer_id           String?

  // Metadata
  verified_at          DateTime @default(now())
  verification_version Int      @default(1)

  // Relationships
  risk_assessment RiskAssessment @relation(fields: [risk_assessment_id], references: [id], onDelete: Cascade)
  repo_scan       RepoScan       @relation(fields: [repo_scan_id], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([risk_assessment_id])
  @@index([repo_scan_id])
  @@index([user_id])
  @@index([final_risk_classification])
  @@index([verified_at])
  @@index([approved_for_report])
  @@map("final_risk_assessments")

  // Feature 5 relationship
  compliance_report ComplianceReport?
}

// Feature 5: Compliance Report
model ComplianceReport {
  id                        String   @id @default(cuid())
  final_risk_assessment_id  String   @unique
  user_id                   String

  // File metadata (stored in Supabase Storage)
  file_name                 String
  file_path                 String   // Supabase storage path: userId/reportId.pdf
  file_url                  String?  // Signed URL (expires)
  file_size                 Int

  // Report data
  risk_classification       String
  risk_score                Int

  // Digital signing
  digital_signature         String?
  signed_at                 DateTime?

  // Versioning
  version                   Int      @default(1)

  // Timestamps
  generated_at              DateTime @default(now())
  expires_at                DateTime? // Signed URL expiration
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  // Relationships
  final_risk_assessment FinalRiskAssessment @relation(fields: [final_risk_assessment_id], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, file_name])
  @@index([user_id])
  @@index([final_risk_assessment_id])
  @@index([generated_at])
  @@map("compliance_reports")
}

// =============================================================================
// GitHub Action MVP - Recurring Revenue Infrastructure
// =============================================================================

// Track GitHub Action installations per repo
model GitHubActionInstall {
  id             String   @id @default(cuid())
  user_id        String
  repo_full_name String   // e.g., "owner/repo"
  repo_id        Int?     // GitHub repo ID
  status         String   @default("active") // active, paused, disabled
  
  // Configuration
  block_on_high_risk    Boolean @default(false) // Block PRs with HIGH_RISK
  block_on_unacceptable Boolean @default(true)  // Block PRs with UNACCEPTABLE
  notify_slack          Boolean @default(false)
  slack_webhook_url     String?
  
  // Metadata
  installed_at  DateTime @default(now())
  last_scan_at  DateTime?
  total_scans   Int      @default(0)
  
  // Relationships
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pr_scans PRScan[]

  @@unique([user_id, repo_full_name])
  @@index([user_id])
  @@index([repo_full_name])
  @@index([status])
  @@map("github_action_installs")
}

// Track individual PR scans
model PRScan {
  id             String   @id @default(cuid())
  user_id        String
  repo_full_name String
  
  // PR Details
  pr_number      Int
  pr_title       String
  pr_url         String
  head_sha       String
  
  // Scan Results
  risk_level          String   // UNACCEPTABLE, HIGH_RISK, LIMITED_RISK, MINIMAL_RISK
  matched_patterns    String[] @default([])
  matched_constraints String[] @default([])
  blocked             Boolean  @default(false)
  comment_posted      Boolean  @default(false)
  
  // Metadata
  scanned_at     DateTime @default(now())
  scan_duration_ms Int?
  
  // Relationships
  user                  User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  github_action_install GitHubActionInstall? @relation(fields: [repo_full_name, user_id], references: [repo_full_name, user_id])

  @@index([user_id])
  @@index([repo_full_name])
  @@index([pr_number])
  @@index([scanned_at])
  @@index([risk_level])
  @@map("pr_scans")
}

// =============================================================================
// Subscription & Billing (Stripe-Ready)
// =============================================================================

model Subscription {
  id        String   @id @default(cuid())
  user_id   String   @unique  // One subscription per user
  
  // Subscription Tier
  tier      String   @default("free") // free, pro, enterprise
  status    String   @default("active") // active, canceled, past_due, trialing
  
  // Usage Limits (per month)
  repos_limit        Int @default(1)  // Free: 1, Pro: 10, Enterprise: unlimited
  scans_limit        Int @default(5)  // Free: 5/month, Pro: 100/month
  pr_scans_limit     Int @default(0)  // Free: 0, Pro: unlimited
  reports_limit      Int @default(1)  // Free: 1/month, Pro: 20/month
  
  // Current Usage (reset monthly)
  repos_used         Int @default(0)
  scans_used         Int @default(0)
  pr_scans_used      Int @default(0)
  reports_used       Int @default(0)
  usage_reset_at     DateTime @default(now())
  
  // Stripe Integration (ready for later)
  stripe_customer_id     String?  @unique
  stripe_subscription_id String?  @unique
  stripe_price_id        String?
  
  // Billing Cycle
  current_period_start  DateTime?
  current_period_end    DateTime?
  cancel_at_period_end  Boolean @default(false)
  
  // Manual Override (for early adopters, demos)
  is_manual_grant     Boolean @default(false)
  manual_grant_reason String?
  granted_by          String?  // Admin user ID
  
  // Metadata
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Relationships
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([status])
  @@index([stripe_customer_id])
  @@map("subscriptions")
}


// Feedback System
model Feedback {
  id        String   @id @default(cuid())
  user_id   String?  // Optional: can be anonymous
  
  rating    Int      // 1-5
  comment   String?
  page_url  String?
  
  // Metadata
  created_at DateTime @default(now())
  
  // Relationships
  user      User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([created_at])
  @@map("feedback")
}

// =============================================================================
// AI System Registry - Phase 1 of Platform Rebuild
// =============================================================================

model AiSystem {
  id              String   @id @default(cuid())
  user_id         String
  
  // Identification
  name            String
  description     String?
  
  // Source (links to existing scan)
  source_repo_url String?
  latest_scan_id  String?  @unique
  
  // Classification (synced from latest assessment)
  risk_classification String?   // UNACCEPTABLE, HIGH_RISK, LIMITED_RISK, MINIMAL_RISK
  risk_score          Int?      // 0-100
  
  // Status
  status          String   @default("active")  // active, archived
  lifecycle_stage String   @default("development")  // development, testing, production, retired
  
  // Last scan metadata
  last_scanned_at   DateTime?
  capabilities      Json?     // Synced from LlmCapabilityAnalysis
  matched_articles  Json?     // Synced from RiskAssessment
  
  // Public sharing (Phase 1.1)
  public_share_id   String?   @unique  // Random ID for public URL
  share_enabled     Boolean   @default(false)
  
  // Code drift tracking (Phase 3.1)
  last_commit_sha     String?   // SHA of last scanned commit
  files_changed_count Int?      @default(0)  // Files changed since last scan
  drift_detected      Boolean   @default(false)
  drift_checked_at    DateTime?
  
  // Timestamps
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relations
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  latest_scan     RepoScan? @relation("AiSystemLatestScan", fields: [latest_scan_id], references: [id])
  scan_history    AiSystemScan[]
  documents       ComplianceDocument[]  // Phase 2: Generated docs
  alerts          MonitoringAlert[]     // Phase 3.3: Monitoring alerts
  audit_logs      AuditLog[]            // Phase 4.1: Audit trail
  evidence        ComplianceEvidence[]  // Phase 4.2: Compliance evidence
  conformity_assessments ConformityAssessment[]  // Phase 5: Conformity tracking
  
  @@unique([user_id, name])
  @@index([user_id])
  @@index([risk_classification])
  @@index([status])
  @@map("ai_systems")
}

// =============================================================================
// Scan History - Phase 1.2: Track all scans per AI System
// =============================================================================

model AiSystemScan {
  id            String   @id @default(cuid())
  ai_system_id  String
  repo_scan_id  String
  
  // Snapshot of risk at time of scan
  risk_classification String?
  risk_score          Int?
  
  // Change tracking
  previous_classification String?
  classification_changed  Boolean @default(false)
  
  scanned_at    DateTime @default(now())
  
  // Relations
  ai_system     AiSystem @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)
  repo_scan     RepoScan @relation("ScanHistory", fields: [repo_scan_id], references: [id], onDelete: Cascade)
  
  @@unique([ai_system_id, repo_scan_id])
  @@index([ai_system_id])
  @@index([scanned_at])
  @@map("ai_system_scans")
}

// =============================================================================
// Compliance Documents - Phase 2: Auto-generated EU AI Act documents
// =============================================================================

model ComplianceDocument {
  id            String   @id @default(cuid())
  ai_system_id  String
  
  // Document Type: technical_doc, risk_management, data_governance, 
  //                instructions_for_use, declaration_of_conformity
  document_type String
  
  // Content
  title         String
  content       Json     // Markdown content + field status
  template_version String @default("1.0")
  
  // Completion Status
  status        String   @default("draft")  // draft, complete, exported
  completion_percent Int @default(0)
  missing_fields Json?   // List of unfilled placeholders
  
  // Version tracking
  version       Int      @default(1)
  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Relations
  ai_system     AiSystem @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)
  
  @@unique([ai_system_id, document_type])
  @@index([ai_system_id])
  @@index([document_type])
  @@map("compliance_documents")
}

// =============================================================================
// Monitoring Alerts - Phase 3.3: Alert system for compliance events
// =============================================================================

model MonitoringAlert {
  id            String   @id @default(cuid())
  user_id       String
  ai_system_id  String?  // Optional - some alerts may be global
  
  // Alert Type
  category      String   // risk_change, drift_detected, compliance_gap, document_missing
  severity      String   @default("info")  // critical, warning, info
  
  // Content
  title         String
  message       String
  
  // Status
  status        String   @default("unread")  // unread, read, resolved, dismissed
  resolved_at   DateTime?
  resolved_by   String?
  
  // Metadata
  metadata      Json?    // Additional context (e.g., previous_risk, new_risk)
  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Relations
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ai_system     AiSystem? @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)
  
  @@index([user_id])
  @@index([ai_system_id])
  @@index([status])
  @@index([category])
  @@map("monitoring_alerts")
}

// =============================================================================
// Audit Log - Phase 4.1: Tamper-proof compliance action logging
// =============================================================================

model AuditLog {
  id            String   @id @default(cuid())
  user_id       String
  ai_system_id  String?
  
  // Action details
  action        String   // scan, classify, generate_doc, export, upload_evidence, etc.
  entity_type   String   // ai_system, document, report, evidence, etc.
  entity_id     String?
  
  // Description
  description   String
  metadata      Json?    // Additional context
  
  // Tamper-proof hash chain
  previous_hash String?  // Hash of previous log entry
  hash          String   // SHA-256 of this entry's content
  
  // IP tracking for audit
  ip_address    String?
  user_agent    String?
  
  created_at    DateTime @default(now())
  
  // Relations
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ai_system     AiSystem? @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)
  
  @@index([user_id])
  @@index([ai_system_id])
  @@index([action])
  @@index([entity_type])
  @@index([created_at])
  @@map("audit_logs")
}

// =============================================================================
// Compliance Evidence - Phase 4.2: Evidence collection and chain of custody
// =============================================================================

model ComplianceEvidence {
  id            String   @id @default(cuid())
  user_id       String
  ai_system_id  String
  
  // Evidence details
  evidence_type String   // scan_result, risk_assessment, document, user_upload, test_result
  title         String
  description   String?
  
  // File storage
  file_url      String?
  file_name     String?
  file_size     Int?
  mime_type     String?
  
  // Source reference
  source_type   String?  // repo_scan, document, upload
  source_id     String?  // ID of the source entity
  
  // Chain of custody
  collected_at  DateTime @default(now())
  collected_by  String   // User ID who collected/uploaded
  hash          String   // SHA-256 file integrity hash
  
  // Verification
  verified      Boolean  @default(false)
  verified_at   DateTime?
  verified_by   String?
  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Relations
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ai_system     AiSystem @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)
  
  @@index([user_id])
  @@index([ai_system_id])
  @@index([evidence_type])
  @@index([collected_at])
  @@map("compliance_evidence")
}

// =============================================================================
// Regulatory Updates - Phase 3.4: Track EU AI Act amendments and guidance
// =============================================================================

model RegulatoryUpdate {
  id              String   @id @default(cuid())
  
  // Source and reference
  source          String   // eu_ai_office, eur_lex, ai_act_news
  source_url      String?
  reference_id    String?  @unique  // External ID to prevent duplicates
  
  // Content
  title           String
  summary         String
  content         String?  // Full text if available
  
  // Classification
  update_type     String   // amendment, guidance, clarification, deadline
  severity        String   @default("info")  // critical, warning, info
  
  // EU AI Act relevance
  affected_articles   String[]  // ["Article 6", "Article 9", "Annex III"]
  affected_risks      String[]  // ["HIGH_RISK", "LIMITED_RISK"]
  
  // Status
  published_at    DateTime
  effective_date  DateTime?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  @@index([update_type])
  @@index([severity])
  @@index([published_at])
  @@map("regulatory_updates")
}

// =============================================================================
// Conformity Assessment - Phase 5: Track conformity assessment pathway progress
// =============================================================================

model ConformityAssessment {
  id              String   @id @default(cuid())
  ai_system_id    String
  user_id         String

  // Assessment Module
  assessment_module String   // MODULE_A, MODULE_B_C, MODULE_D, MODULE_F, NOT_REQUIRED
  module_name       String
  legal_basis       String

  // Progress
  current_step    Int      @default(0)
  total_steps     Int
  steps_data      Json     // ConformityStep[] serialised

  // Status
  status          String   @default("not_started")  // not_started, in_progress, completed, needs_review
  completion_percent Int   @default(0)

  // Configuration
  requires_notified_body Boolean @default(false)
  self_assessment_eligible Boolean @default(false)
  estimated_timeline String?

  // Metadata
  risk_classification String?
  annex_iii_category  Int?
  notes              Json?    // string[]

  // Target date for completion
  target_date     DateTime?

  // Timestamps
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ai_system       AiSystem @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)

  @@unique([ai_system_id])
  @@index([user_id])
  @@index([status])
  @@map("conformity_assessments")
}

// =============================================================================
// Demo Requests — Lead Capture from Request Demo page
// =============================================================================

model DemoRequest {
  id            String   @id @default(cuid())
  
  // Contact Info
  full_name     String
  work_email    String
  company_name  String
  company_size  String   // 1-10, 11-50, 51-200, 201-1000, 1000+
  
  // Optional Qualification
  role          String?  // CTO/VP Engineering, Engineering Lead, Compliance/Legal, Product Manager, Other
  use_case      String?  // preparing_for_eu_ai_act, already_under_audit, evaluating_tools, other
  
  // Internal Management
  status        String   @default("new")  // new, contacted, qualified, converted
  notes         String?  // Admin notes
  
  // Metadata
  ip_address    String?
  user_agent    String?
  referrer      String?
  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([work_email])
  @@index([status])
  @@index([created_at])
  @@map("demo_requests")
}
